{
  "name": "ipmax",
  "version": "0.1.0",
  "description": "TypeScript client for the IP-Max GeoIP and IP intelligence API",
  "keywords": [
    "ipmax",
    "geoip",
    "ip",
    "intelligence",
    "asn",
    "sdk"
  ],
  "homepage": "https://ipm.ax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IPMaxxing/typescript-sdk.git"
  },
  "bugs": "https://github.com/IPMaxxing/typescript-sdk/issues",
  "license": "Apache-2.0",
  "author": "IP-Max <opensource@ipm.ax>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "node --test test/*.test.ts",
    "check:package": "publint --strict && attw --pack ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "publint": "^0.3.25",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  }
}
